VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:REPLACE_WITH_YOUR_EMAIL

# 19-3: Naver DataLab 검색어트렌드 API (https://developers.naver.com 에서 애플리케이션 등록 후 발급)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 19-4: Google Trends API (Alpha) - 2026-09 기준 공식 endpoint/인증 방식이
# 공개되지 않은 신청제 Alpha 단계입니다. 아래 두 값은 실제 접근 권한을 받고
# 공식 문서를 확인한 뒤에만 채워 넣을 수 있는 placeholder이며, 비어 있으면
# googleTrendsCollector가 네트워크 요청을 시도하지 않습니다.
GOOGLE_TRENDS_API_ENDPOINT=
GOOGLE_TRENDS_API_KEY=

# YouTube Data API v3 (https://console.cloud.google.com 에서 프로젝트 생성 후
# "YouTube Data API v3" 활성화 -> 사용자 인증 정보에서 API 키 발급)
YOUTUBE_API_KEY=

# 20-11: Supabase (youtube_daily_trends 테이블 저장용). Supabase 프로젝트의
# Project Settings > API에서 확인. SERVICE_ROLE_KEY는 RLS를 우회하는 강력한
# 키이므로 절대 프론트엔드에 노출하지 말고 서버 환경변수로만 사용합니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 21-2(2-3B단계): Google Gemini API - https://aistudio.google.com/apikey 에서
# 발급(신용카드 불필요). YouTube Trend Score를 짧게 설명하는 데만 사용
# (gemini-2.5-flash-lite). 2-3단계의 ANTHROPIC_API_KEY를 대체합니다.
GEMINI_API_KEY=

# 3-4단계: tracked_keywords에 등록된 키워드를 8시간마다 자동 수집(YouTube/
# 뉴스/네이버)하는 스케줄러를 켤지 여부입니다. 정확히 "true"일 때만
# 활성화되며, 기본값(미설정)은 꺼짐입니다 - 무료 할당량을 의도치 않게
# 소모하지 않도록 명시적으로 켜야만 동작합니다.
# 4-1단계: spin-down 배포 환경에서는 이 값을 계속 미설정(꺼짐) 상태로
# 두고, 대신 아래 SCHEDULER_SECRET + POST /api/scheduler/trigger를 쓰세요.
SCHEDULER_ENABLED=

# 4-1단계: POST /api/scheduler/trigger 호출 시 X-Scheduler-Secret 헤더와
# 비교하는 값입니다. 외부 크론 서비스(cron-job.org 등)만 이 값을 알고
# 있어야 하므로, 충분히 긴 랜덤 문자열로 직접 생성해서 채우세요(예:
# openssl rand -hex 32). 비어 있으면 트리거 엔드포인트는 항상 401을
# 반환합니다(아무도 트리거할 수 없음 - 의도된 안전한 기본값).
SCHEDULER_SECRET=

# Phase A: 브라우저(src/supabaseClient.js)에서 Supabase Auth(회원가입/
# 로그인)에 쓰는 값입니다. 위 SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY와는
# 완전히 다른 용도입니다 - VITE_SUPABASE_ANON_KEY는 RLS 정책의 제한을
# 받는 공개 키라 브라우저에 노출돼도 안전하지만, SUPABASE_SERVICE_ROLE_KEY는
# 절대 여기 넣거나 VITE_ 접두사를 붙이면 안 됩니다(그 순간 브라우저 번들에
# 포함되어 RLS를 우회하는 권한이 그대로 유출됩니다). Vite는 VITE_ 접두사가
# 붙은 변수만 클라이언트에 노출시킨다는 점을 이용한 구분입니다.
# Project URL은 SUPABASE_URL과 동일한 값이고, 키만 anon/public 키로
# 다릅니다(Supabase 콘솔 Settings > API에서 확인).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Phase D: 토스페이먼츠 자동결제(빌링) - developers.tosspayments.com의
# API 키 메뉴에서 "API 개별 연동 키"(위젯/결제창 연동 키 아님 - 자동결제는
# 개별 연동 키가 필요)를 발급받아 채워 넣으세요. test_ 접두사는 테스트 키,
# live_ 접두사는 실서비스 키입니다.
# TOSS_SECRET_KEY는 서버 전용 비밀값이라 절대 VITE_ 접두사를 붙이면 안
# 됩니다(빌링키 발급/결제 승인 API를 호출할 때만 서버가 사용).
# TOSS_CLIENT_KEY(서버용)와 VITE_TOSS_CLIENT_KEY(브라우저 SDK용)는 같은
# 클라이언트 키 값이면 되지만, Vite가 VITE_ 접두사 변수만 브라우저 번들에
# 노출하므로 두 이름 모두 채워야 합니다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
VITE_TOSS_CLIENT_KEY=

# Phase D: POST /api/subscription/process-renewals 호출 시
# X-Subscription-Renewal-Secret 헤더와 비교하는 값입니다. SCHEDULER_SECRET과
# 별개의 값을 쓰세요(트렌드 수집 스케줄러와 결제 재청구를 독립적으로 켜고
# 끌 수 있어야 함) - 충분히 긴 랜덤 문자열로 직접 생성하세요.
SUBSCRIPTION_RENEWAL_SECRET=
